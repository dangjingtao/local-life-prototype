{
  "name": "local-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Tomz <dangjingtao@gmail.com> & Mira <mira@tomz.io>",
  "contributors": [
    "Tomz <dangjingtao@gmail.com>",
    "Mira <mira@tomz.io>"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run dev --workspace @prototype/mobile",
    "dev:pc": "npm run dev --workspace @prototype/pc",
    "build:mobile": "npm run build --workspace @prototype/mobile",
    "build:pc": "npm run build --workspace @prototype/pc",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
